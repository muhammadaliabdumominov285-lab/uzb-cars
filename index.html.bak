          <input type="text" id="carSearchInput" placeholder="Model, brend yoki narx bo'yicha qidirish (masalan: Cobalt, Malibu, BMW...)" class="search-input">
          <button type="button" id="clearSearchBtn" class="clear-search-btn" style="display:none;"><i class="fa-solid fa-xmark"></i></button>
        </div>

        <!-- Toifalar bo'yicha filtrlar -->
        <div class="filter-pills-group" id="filterPillsGroup">
          <button type="button" class="filter-pill active" data-filter="all"><i class="fa-solid fa-border-all"></i> Barchasi (14)</button>
          <button type="button" class="filter-pill" data-filter="uzb"><i class="fa-solid fa-flag text-uzb"></i> O'zbek (UzAuto)</button>
          <button type="button" class="filter-pill" data-filter="import"><i class="fa-solid fa-gem"></i> Premium Import</button>
          <button type="button" class="filter-pill" data-filter="sedan"><i class="fa-solid fa-car-side"></i> Sedanlar</button>
          <button type="button" class="filter-pill" data-filter="suv"><i class="fa-solid fa-truck-monster"></i> Krossover & SUV</button>
          <button type="button" class="filter-pill" data-filter="ev"><i class="fa-solid fa-bolt"></i> Elektromobil</button>
        </div>

        <!-- Narx bo'yicha saralash -->
        <div class="filter-sort-wrap">
          <label for="carSortSelect"><i class="fa-solid fa-arrow-down-short-wide"></i> Saralash:</label>
          <select id="carSortSelect" class="sort-select">
            <option value="default">Tavsiya etilgan</option>
            <option value="price-asc">Narx: Arzondan qimmatga</option>
            <option value="price-desc">Narx: Qimmatdan arzonga</option>
            <option value="power-desc">Ot kuchi: Kattasidan</option>
          </select>
        </div>

      </div>

      <!-- Qidiruv natijasi hisoblagichi -->
      <div class="filter-status-bar">
        <span id="filterCount">34 ta avtomobil topildi</span>
        <button type="button" class="btn-pdf-catalog" id="btnPdfCatalog" title="Barcha narxlar jadvalini PDF formatda ko'rish va chop etish">
          <i class="fa-solid fa-file-pdf"></i>
          <span>Katalog & Narxlar (PDF)</span>
        </button>
        <button type="button" id="resetFiltersBtn" class="reset-filter-link" style="display: none;">Filtrlarni tozalash</button>
      </div>

    </div>
  </section>

