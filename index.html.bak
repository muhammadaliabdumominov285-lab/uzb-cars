        <form class="booking-form" id="bookingForm">

          <h3>Avtomobilni Band Qilish / Test-Drayv</h3>

          <div id="formAlert" class="form-alert">

            <i class="fa-solid fa-circle-check"></i>

            <strong>Rahmat! Arizangiz qabul qilindi.</strong>

            <p style="margin-top: 0.25rem; font-size: 0.85rem; color: #a7f3d0;">Operatorimiz tez orada siz bilan bog'lanadi!</p>

