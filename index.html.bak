  <!-- Interaktiv skriptlar (Mobil menyu va ariza jo'natish) -->

  <script>

    // 1. Mobil menyudagi havola bosilganda menyuni avtomatik yopish

    document.querySelectorAll('.nav-menu .nav-link').forEach(link => {

      link.addEventListener('click', () => {

        const toggle = document.getElementById('menu-toggle');

        if (toggle) toggle.checked = false;

      });

    });

    // 2. Buyurtma formasini qayta ishlash va Telegramga yo'naltirish

    const bookingForm = document.getElementById('bookingForm');

    const formAlert = document.getElementById('formAlert');

    if (bookingForm) {

      bookingForm.addEventListener('submit', function(e) {

        e.preventDefault();

        const name = document.getElementById('client-name').value.trim();

        const phone = document.getElementById('client-phone').value.trim();

        const car = document.getElementById('car-select').value;

        const payment = document.getElementById('payment-type').value;

        const notes = document.getElementById('client-notes').value.trim();

        // Xabar matni

        const msgText = `🚗 AUTO MOTORS - Yangi buyurtma!\n\n👤 Mijoz: ${name}\n📞 Telefon: ${phone}\n🚘 Model: ${car}\n💳 To'lov shakli: ${payment}${notes ? '\n📝 Qo\'shimcha izoh: ' + notes : ''}`;

        // Muvaffaqiyat xabarini ko'rsatish

        if (formAlert) {

          formAlert.classList.add('show');

          formAlert.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

        }

        // Telegram orqali operatorga xabarni tayyorlash

        const tgUrl = `https://t.me/share/url?url=${encodeURIComponent('https://t.me/+998973419500')}&text=${encodeURIComponent(msgText)}`;

        setTimeout(() => {

          window.open(tgUrl, '_blank');

        }, 600);

        bookingForm.reset();

      });

    }

  
    // 3. Avtomobil kartasi bosilganda Modal oynasini ochish (Chapda ma'lumot, o'ngda rasm)
    const carModal = document.getElementById('carModal');
    const carModalClose = document.getElementById('carModalClose');
    const carModalBackdrop = document.getElementById('carModalBackdrop');
    const cmTitle = document.getElementById('cmTitle');
    const cmBrand = document.getElementById('cmBrand');
    const cmYear = document.getElementById('cmYear');
    const cmBadge = document.getElementById('cmBadge');
    const cmPriceMain = document.getElementById('cmPriceMain');
    const cmPriceSub = document.getElementById('cmPriceSub');
    const cmSpecsGrid = document.getElementById('cmSpecsGrid');
    const cmImage = document.getElementById('cmImage');
    const cmBookBtn = document.getElementById('cmBookBtn');

    function openCarModal(card) {
      const title = card.querySelector('.car-name')?.innerText.trim() || '';
      const brand = card.querySelector('.car-brand')?.innerText.trim() || '';
      const year = card.querySelector('.car-year')?.innerText.trim() || '';
      const badge = card.querySelector('.badge-condition')?.innerText.trim() || '';
      const priceMain = card.querySelector('.price-main')?.innerText.trim() || '';
      const priceSub = card.querySelector('.price-sub')?.innerText.trim() || '';
      const img = card.querySelector('.car-image-box img');
      const imgSrc = img ? img.getAttribute('src') : '';
      const specs = card.querySelectorAll('.spec-item');

      if (cmTitle) cmTitle.innerText = title;
      if (cmBrand) cmBrand.innerText = brand;
      if (cmYear) cmYear.innerText = year;
      if (cmBadge) cmBadge.innerText = badge;
      if (cmPriceMain) cmPriceMain.innerText = priceMain;
      if (cmPriceSub) cmPriceSub.innerText = priceSub;
      if (cmImage) {
        cmImage.src = imgSrc;
        cmImage.alt = title;
      }

      // Xarakteristikalarni to'ldirish
      if (cmSpecsGrid) {
        cmSpecsGrid.innerHTML = '';
        specs.forEach(spec => {
          const clone = spec.cloneNode(true);
          cmSpecsGrid.appendChild(clone);
        });
      }

      // "Band qilish" tugmasi: modalni yopib, formaga o'tish va avtomatik tanlash
      if (cmBookBtn) {
        cmBookBtn.onclick = function() {
          closeCarModal();
          const select = document.getElementById('car-select');
          if (select) {
            for (let i = 0; i < select.options.length; i++) {
              const optText = select.options[i].text.toLowerCase();
              const carWords = title.toLowerCase().split(' ');
              if (optText.includes(title.toLowerCase()) || 
                  (carWords[1] && optText.includes(carWords[1]))) {
                select.selectedIndex = i;
                break;
              }
            }
          }
          const contactSec = document.getElementById('contact');
          if (contactSec) {
            contactSec.scrollIntoView({ behavior: 'smooth' });
          }
        };
      }

      if (carModal) {
        carModal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeCarModal() {
      if (carModal) {
        carModal.classList.remove('active');
        document.body.style.overflow = '';
      }
    }

    // Har bir mashina kartasiga bosish hodisasi
    document.querySelectorAll('.car-card').forEach(card => {
      card.addEventListener('click', function(e) {
        if (e.target.closest('.btn-book')) {
          const title = card.querySelector('.car-name')?.innerText.trim() || '';
          const select = document.getElementById('car-select');
          if (select && title) {
            for (let i = 0; i < select.options.length; i++) {
              const optText = select.options[i].text.toLowerCase();
              const carWords = title.toLowerCase().split(' ');
              if (optText.includes(title.toLowerCase()) || (carWords[1] && optText.includes(carWords[1]))) {
                select.selectedIndex = i;
                break;
              }
            }
          }
          return;
        }
        openCarModal(card);
      });
    });

    if (carModalClose) carModalClose.addEventListener('click', closeCarModal);
    if (carModalBackdrop) carModalBackdrop.addEventListener('click', closeCarModal);
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && carModal && carModal.classList.contains('active')) {
        closeCarModal();
      }
    });

  
    // ==========================================================
    // 4. BARCHA YANGI FUNKSIYALAR JAVASCRIPT MOTORLARI
    // ==========================================================

    // A. VALYUTA ALMASHTIRGICH ($ USD <-> UZS SO'M)
    const USD_TO_UZS = 12850;
    let currentCurrency = 'USD';

    function formatCurrency(usdAmount, isMonthly = false) {
      if (currentCurrency === 'USD') {
        return '$' + usdAmount.toLocaleString('en-US') + (isMonthly ? ' / oy' : '');
      } else {
        const uzs = Math.round(usdAmount * USD_TO_UZS);
        if (uzs >= 1000000000) {
          return (uzs / 1000000000).toFixed(2) + ' mlrd so\'m' + (isMonthly ? ' / oy' : '');
        } else if (uzs >= 1000000) {
          return (uzs / 1000000).toFixed(1) + ' mln so\'m' + (isMonthly ? ' / oy' : '');
        } else {
          return uzs.toLocaleString('ru-RU') + ' so\'m' + (isMonthly ? ' / oy' : '');
        }
      }
    }

    function updateAllPrices() {
      // 1. Kartochkalardagi narxlarni yangilash
      document.querySelectorAll('.car-card').forEach(card => {
        const pMain = card.querySelector('.price-main');
        const pSub = card.querySelector('.price-sub');
        const usdPrice = parseInt(card.getAttribute('data-price')) || 0;
        const usdCredit = parseInt(card.getAttribute('data-credit')) || 0;

        if (usdPrice && pMain) {
          pMain.innerText = formatCurrency(usdPrice);
        }
        if (usdCredit && pSub) {
          pSub.innerText = 'Kredit: ' + formatCurrency(usdCredit, true);
        }
      });

      // 2. Kalkulyator va Taqqoslashni qayta hisoblash
      if (typeof updateCalculator === 'function') updateCalculator();
      if (typeof updateComparison === 'function') updateComparison();
    }

    document.querySelectorAll('#currencyToggle .curr-pill').forEach(btn => {
      btn.addEventListener('click', function() {
        document.querySelectorAll('#currencyToggle .curr-pill').forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        currentCurrency = this.getAttribute('data-curr');
        updateAllPrices();
      });
    });

    // B. JONLI QIDIRUV VA FILTRLASH
    const carSearchInput = document.getElementById('carSearchInput');
    const clearSearchBtn = document.getElementById('clearSearchBtn');
    const filterPills = document.querySelectorAll('#filterPillsGroup .filter-pill');
    const carSortSelect = document.getElementById('carSortSelect');
    const filterCount = document.getElementById('filterCount');
    const resetFiltersBtn = document.getElementById('resetFiltersBtn');

    let activeFilter = 'all';

    function filterAndSortCars() {
      const query = (carSearchInput ? carSearchInput.value : '').toLowerCase().trim();
      const allCards = Array.from(document.querySelectorAll('.car-card'));
      let visibleCount = 0;

      // Filtrlash
      allCards.forEach(card => {
        const name = (card.getAttribute('data-name') || card.querySelector('.car-name')?.innerText || '').toLowerCase();
        const origin = card.getAttribute('data-origin') || '';
        const category = card.getAttribute('data-category') || '';

        let matchesSearch = !query || name.includes(query);
        let matchesFilter = false;

        if (activeFilter === 'all') matchesFilter = true;
        else if (activeFilter === 'uzb' && origin === 'uzb') matchesFilter = true;
        else if (activeFilter === 'import' && origin === 'import') matchesFilter = true;
        else if (activeFilter === 'sedan' && category.includes('sedan')) matchesFilter = true;
        else if (activeFilter === 'suv' && category.includes('suv')) matchesFilter = true;
        else if (activeFilter === 'ev' && category.includes('ev')) matchesFilter = true;

        if (matchesSearch && matchesFilter) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      // Saralash
      const sortVal = carSortSelect ? carSortSelect.value : 'default';
      const grids = document.querySelectorAll('.cars-grid');

      grids.forEach(grid => {
        const cardsInGrid = Array.from(grid.querySelectorAll('.car-card'));
        if (sortVal === 'price-asc') {
          cardsInGrid.sort((a, b) => (parseInt(a.getAttribute('data-price')) || 0) - (parseInt(b.getAttribute('data-price')) || 0));
        } else if (sortVal === 'price-desc') {
          cardsInGrid.sort((a, b) => (parseInt(b.getAttribute('data-price')) || 0) - (parseInt(a.getAttribute('data-price')) || 0));
        } else if (sortVal === 'power-desc') {
          cardsInGrid.sort((a, b) => (parseInt(b.getAttribute('data-hp')) || 0) - (parseInt(a.getAttribute('data-hp')) || 0));
        }
        cardsInGrid.forEach(c => grid.appendChild(c));
      });

      if (filterCount) {
        filterCount.innerText = visibleCount + ' ta avtomobil topildi';
      }

      if (resetFiltersBtn) {
        resetFiltersBtn.style.display = (query || activeFilter !== 'all' || sortVal !== 'default') ? 'inline-block' : 'none';
      }

      if (clearSearchBtn) {
        clearSearchBtn.style.display = query ? 'block' : 'none';
      }
    }

    if (carSearchInput) carSearchInput.addEventListener('input', filterAndSortCars);
    if (clearSearchBtn) {
      clearSearchBtn.addEventListener('click', () => {
        carSearchInput.value = '';
        filterAndSortCars();
      });
    }

    filterPills.forEach(pill => {
      pill.addEventListener('click', function() {
        filterPills.forEach(p => p.classList.remove('active'));
        this.classList.add('active');
        activeFilter = this.getAttribute('data-filter');
        filterAndSortCars();
      });
    });

    if (carSortSelect) carSortSelect.addEventListener('change', filterAndSortCars);
    if (resetFiltersBtn) {
      resetFiltersBtn.addEventListener('click', () => {
        if (carSearchInput) carSearchInput.value = '';
        activeFilter = 'all';
        filterPills.forEach(p => p.classList.remove('active'));
        filterPills[0]?.classList.add('active');
        if (carSortSelect) carSortSelect.value = 'default';
        filterAndSortCars();
      });
    }

    // C. AVTO-KREDIT KALKULYATORI MOTOR
        const allCarsData = [
