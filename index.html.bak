        <source src="https://upload.wikimedia.org/wikipedia/commons/f/fa/Cars_Passing_by_at_Night.webm" type="video/webm">

      </video>

      <div class="hero-video-overlay"></div>

    </div>

    <div class="container hero-inner">

      

      <div class="hero-tag">

        <span class="badge-live"></span>

        <span>O'zbekiston & Xorijiy Avtomobillar Saloni &mdash; 0 km yangi mashinalar</span>

      </div>

      <h1 class="hero-title">
        Orzuingizdagi <span class="text-accent">Avtomobilni</span> Tanlang
      </h1>

      <p class="hero-desc">

        UzAuto Motorsning eng xaridorgir modellari (Cobalt, Gentra, Tracker, Malibu, Onix) hamda dunyo brendlarining premium avtomobillari salonda mavjud. Qulay kredit, lizing va 1 kunda rasmiylashtirish.

      </p>

      <div class="hero-buttons">

        <a href="#uzb-cars" class="btn btn-uzb">

          <i class="fa-solid fa-car"></i>

          <span>O'zbek Mashinalari</span>

        </a>

        <a href="#import-cars" class="btn btn-primary">

          <span>Premium Import</span>

          <i class="fa-solid fa-arrow-right"></i>

        </a>

        <a href="#contact" class="btn btn-glass">

          <i class="fa-solid fa-calendar-check text-accent"></i>

          <span>Test-Drayv</span>

        </a>

      </div>

      <!-- Statistika ko'rsatkichlari -->

      <div class="hero-stats">
        <div class="hero-stat-card">
          <div class="stat-icon"><i class="fa-solid fa-warehouse"></i></div>
          <div>
            <div class="stat-num">250+</div>
            <div class="stat-label">Salondagi mashinalar</div>
          </div>
        </div>
        <div class="hero-stat-card">
          <div class="stat-icon"><i class="fa-solid fa-gauge-high"></i></div>
          <div>
            <div class="stat-num">0 km</div>
            <div class="stat-label">Yangi va kafolatli</div>
          </div>
        </div>
        <div class="hero-stat-card">
