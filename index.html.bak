      { id: 30, name: 'Range Rover SV Autobiography', price: 260000, hp: 530, engine: '4.4L Twin-Turbo V8', gear: '8-Avtomat ZF AWD', fuel: '11.9 L/100km', img: 'https://images.unsplash.com/photo-1606016159991-dfe4f2746ad5?auto=format&fit=crop&w=800&q=80' },
      { id: 31, name: 'Lexus LX 600 VIP Black Edition', price: 175000, hp: 415, engine: '3.5L V6 Twin-Turbo', gear: '10-Avtomat Direct', fuel: '12.5 L/100km', img: 'https://images.unsplash.com/photo-1533473359331-0135ef1b58bf?auto=format&fit=crop&w=800&q=80' },
      { id: 32, name: 'Tesla Model S Plaid EV', price: 115000, hp: 1020, engine: 'Tri-Motor AWD EV', gear: '1-Tezlik Avtomat', fuel: '600 km masofa', img: 'https://images.unsplash.com/photo-1617788138017-80ad40651399?auto=format&fit=crop&w=800&q=80' },
      { id: 33, name: 'Cadillac Escalade-V Supercharged', price: 185000, hp: 682, engine: '6.2L Supercharged V8', gear: '10-Avtomat Hydra', fuel: '15.2 L/100km', img: 'https://images.unsplash.com/photo-1563720223185-11003d516935?auto=format&fit=crop&w=800&q=80' },
      { id: 34, name: 'Bentley Continental GT Speed', price: 310000, hp: 650, engine: '6.0L W12 TSI Turbo', gear: '8-Dual-Clutch AWD', fuel: '13.7 L/100km', img: 'https://images.unsplash.com/photo-1580273916550-e323be2ae537?auto=format&fit=crop&w=800&q=80' }
    ];

    const calcCarSelect = document.getElementById('calcCarSelect');
    const calcPercentRange = document.getElementById('calcPercentRange');
    const calcPercentDisplay = document.getElementById('calcPercentDisplay');
    const calcDownAmountText = document.getElementById('calcDownAmountText');
    const resMonthlyPayment = document.getElementById('resMonthlyPayment');
    const resCarPrice = document.getElementById('resCarPrice');
    const resDownPay = document.getElementById('resDownPay');
    const csCarPrice = document.getElementById('csCarPrice');
    const csDownPay = document.getElementById('csDownPay');
    const csLoanAmount = document.getElementById('csLoanAmount');
    const calcSubmitBtn = document.getElementById('calcSubmitBtn');

    let calcTenureMonths = 36;

    if (calcCarSelect) {
      allCarsData.forEach((car, i) => {
        const opt = document.createElement('option');
        opt.value = i;
        opt.text = car.name + ' ($' + car.price.toLocaleString('en-US') + ')';
        calcCarSelect.appendChild(opt);
      });
    }

    function updateCalculator() {
      if (!calcCarSelect) return;
      const selectedIndex = parseInt(calcCarSelect.value) || 0;
      const car = allCarsData[selectedIndex] || allCarsData[0];
      const downPercent = parseInt(calcPercentRange.value) || 30;

      const totalPrice = car.price;
      const downPayment = Math.round(totalPrice * (downPercent / 100));
      const loanPrincipal = totalPrice - downPayment;

      // Anuitet foiz hisobi (18% yillik stavka)
      const annualRate = 0.18;
      const monthlyRate = annualRate / 12;
      const monthlyPayment = Math.round(
        (loanPrincipal * monthlyRate * Math.pow(1 + monthlyRate, calcTenureMonths)) /
        (Math.pow(1 + monthlyRate, calcTenureMonths) - 1)
      );

      if (calcPercentDisplay) calcPercentDisplay.innerText = downPercent + '%';
      if (calcDownAmountText) calcDownAmountText.innerText = formatCurrency(downPayment);
      if (resMonthlyPayment) resMonthlyPayment.innerText = formatCurrency(monthlyPayment, true);
      if (csCarPrice) csCarPrice.innerText = formatCurrency(totalPrice);
      if (csDownPay) csDownPay.innerText = formatCurrency(downPayment) + ' (' + downPercent + '%)';
      if (csLoanAmount) csLoanAmount.innerText = formatCurrency(loanPrincipal);
    }

    if (calcCarSelect) calcCarSelect.addEventListener('change', updateCalculator);
    if (calcPercentRange) calcPercentRange.addEventListener('input', updateCalculator);

    document.querySelectorAll('#tenureTabs .tenure-tab').forEach(tab => {
      tab.addEventListener('click', function() {
        document.querySelectorAll('#tenureTabs .tenure-tab').forEach(t => t.classList.remove('active'));
        this.classList.add('active');
        calcTenureMonths = parseInt(this.getAttribute('data-months')) || 36;
        updateCalculator();
      });
    });

    if (calcSubmitBtn) {
      calcSubmitBtn.addEventListener('click', function() {
        const car = allCarsData[parseInt(calcCarSelect.value) || 0];
        const downPercent = calcPercentRange.value;
        const select = document.getElementById('car-select');
        if (select && car) {
          for (let i = 0; i < select.options.length; i++) {
            if (select.options[i].text.toLowerCase().includes(car.name.toLowerCase().split(' ')[1])) {
              select.selectedIndex = i;
              break;
            }
          }
        }
        const notes = document.getElementById('client-notes');
        if (notes && car) {
          notes.value = 'Hisoblangan kredit: ' + car.name + ', Boshlang\'ich to\'lov: ' + downPercent + '%, Muddat: ' + calcTenureMonths + ' oy.';
        }
        const contactSec = document.getElementById('contact');
        if (contactSec) contactSec.scrollIntoView({ behavior: 'smooth' });
      });
    }

    // D. TAQQOSLASH (COMPARE TOOL) MOTOR
    const compSel1 = document.getElementById('compareCar1');
    const compSel2 = document.getElementById('compareCar2');

    if (compSel1 && compSel2) {
      allCarsData.forEach((car, i) => {
        const opt1 = document.createElement('option');
        opt1.value = i;
        opt1.text = car.name;
        compSel1.appendChild(opt1);

        const opt2 = document.createElement('option');
        opt2.value = i;
        opt2.text = car.name;
        compSel2.appendChild(opt2);
      });
      // Default: Cobalt vs Onix
      compSel1.value = 3; // Cobalt
      compSel2.value = 2; // Onix
    }

    function updateComparison() {
      if (!compSel1 || !compSel2) return;
      const c1 = allCarsData[parseInt(compSel1.value) || 0];
      const c2 = allCarsData[parseInt(compSel2.value) || 1];

      document.getElementById('compName1').innerText = c1.name;
      document.getElementById('compName2').innerText = c2.name;

      document.getElementById('compImg1').src = c1.img;
      document.getElementById('compImg2').src = c2.img;

      document.getElementById('compPrice1').innerText = formatCurrency(c1.price);
      document.getElementById('compPrice2').innerText = formatCurrency(c2.price);

      const m1 = Math.round((c1.price * 0.7 * (0.18/12) * Math.pow(1 + 0.18/12, 36)) / (Math.pow(1 + 0.18/12, 36) - 1));
      const m2 = Math.round((c2.price * 0.7 * (0.18/12) * Math.pow(1 + 0.18/12, 36)) / (Math.pow(1 + 0.18/12, 36) - 1));
      document.getElementById('compCredit1').innerText = formatCurrency(m1, true);
      document.getElementById('compCredit2').innerText = formatCurrency(m2, true);

      document.getElementById('compEngine1').innerText = c1.engine;
      document.getElementById('compEngine2').innerText = c2.engine;

      document.getElementById('compHp1').innerText = c1.hp + ' ot kuchi';
      document.getElementById('compHp2').innerText = c2.hp + ' ot kuchi';

      document.getElementById('compGear1').innerText = c1.gear;
      document.getElementById('compGear2').innerText = c2.gear;

      document.getElementById('compFuel1').innerText = c1.fuel;
      document.getElementById('compFuel2').innerText = c2.fuel;

      // Book buttons
      document.getElementById('compBook1').onclick = () => {
        selectCarAndScroll(c1.name);
      };
      document.getElementById('compBook2').onclick = () => {
        selectCarAndScroll(c2.name);
      };
    }

    function selectCarAndScroll(carName) {
      const select = document.getElementById('car-select');
      if (select) {
        for (let i = 0; i < select.options.length; i++) {
          if (select.options[i].text.toLowerCase().includes(carName.toLowerCase().split(' ')[1])) {
            select.selectedIndex = i;
            break;
          }
        }
      }
      const contactSec = document.getElementById('contact');
      if (contactSec) contactSec.scrollIntoView({ behavior: 'smooth' });
    }

    if (compSel1) compSel1.addEventListener('change', updateComparison);
    if (compSel2) compSel2.addEventListener('change', updateComparison);

    // E. FAQ AKORDEON
    document.querySelectorAll('.faq-question').forEach(btn => {
      btn.addEventListener('click', function() {
        const item = this.parentElement;
        const isActive = item.classList.contains('active');
        document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('active'));
        if (!isActive) {
          item.classList.add('active');
        }
      });
    });

    
    // ==========================================================
    // 5. YANGI 6 TA SUPER FUNKSIYALAR JAVASCRIPT MOTORLARI
    // ==========================================================

    // ----------------------------------------------------------
    // A. JONLI ISH VAQTI & ONLAYN STATUS INDIKATORI
    // ----------------------------------------------------------
    function updateShowroomStatus() {
      const statusPill = document.getElementById('showroomStatus');
      const statusText = document.getElementById('statusText');
      if (!statusPill || !statusText) return;

      const now = new Date();
      const hour = now.getHours();
      const isOpen = hour >= 9 && hour < 20;

      if (isOpen) {
        statusPill.classList.remove('status-closed');
        statusPill.classList.add('status-open');
        statusText.innerText = "Ochiq: 09:00 - 20:00 • Onlayn";
      } else {
        statusPill.classList.remove('status-open');
        statusPill.classList.add('status-closed');
        statusText.innerText = "Dam olish vaqti • Ochiladi: 09:00";
      }
    }
    updateShowroomStatus();
    setInterval(updateShowroomStatus, 60000);

    // ----------------------------------------------------------
    // B. SEVIMLILAR (WISHLIST) TIZIMI & LOCALSTORAGE
    // ----------------------------------------------------------
    let wishlist = [];
    try {
      wishlist = JSON.parse(localStorage.getItem('automotors_wishlist')) || [];
    } catch (e) {
      wishlist = [];
    }

    const wishlistToggleBtn = document.getElementById('wishlistToggleBtn');
    const wishlistCloseBtn = document.getElementById('wishlistCloseBtn');
    const wishlistBackdrop = document.getElementById('wishlistBackdrop');
    const wishlistDrawer = document.getElementById('wishlistDrawer');
    const wishlistBadge = document.getElementById('wishlistBadge');
    const wishlistHeaderCount = document.getElementById('wishlistHeaderCount');
    const wishlistItemsList = document.getElementById('wishlistItemsList');
    const wishlistTotalPrice = document.getElementById('wishlistTotalPrice');
    const wishlistOrderAllBtn = document.getElementById('wishlistOrderAllBtn');
    const wishlistClearBtn = document.getElementById('wishlistClearBtn');
    const toastNotification = document.getElementById('toastNotification');
    const toastMessage = document.getElementById('toastMessage');

    let toastTimer = null;
    function showToast(msg) {
      if (!toastNotification || !toastMessage) return;
      toastMessage.innerText = msg;
      toastNotification.classList.add('active');
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toastNotification.classList.remove('active');
      }, 3000);
    }

    function saveWishlist() {
      try {
        localStorage.setItem('automotors_wishlist', JSON.stringify(wishlist));
      } catch (e) {}
      updateWishlistUI();
    }

    function updateWishlistUI() {
      // 1. Badge va hisoblagichlarni yangilash
      const count = wishlist.length;
      if (wishlistBadge) wishlistBadge.innerText = count;
      if (wishlistHeaderCount) wishlistHeaderCount.innerText = count;

      // 2. Kartochkalardagi yurakchalarni faollashtirish
      document.querySelectorAll('.car-card').forEach(card => {
        const name = card.getAttribute('data-name') || card.querySelector('.car-name')?.innerText.trim() || '';
        const heartIcon = card.querySelector('.car-like-icon');
        const heartI = card.querySelector('.car-like-icon i');
        if (heartIcon && heartI) {
          const isSaved = wishlist.some(item => item.name === name);
          if (isSaved) {
            heartIcon.classList.add('active');
            heartI.className = 'fa-solid fa-heart text-accent';
          } else {
            heartIcon.classList.remove('active');
            heartI.className = 'fa-regular fa-heart';
          }
        }
      });

      // 3. Drawer ro'yxatini render qilish
      if (!wishlistItemsList) return;
      if (wishlist.length === 0) {
        wishlistItemsList.innerHTML = `
          <div class="wishlist-empty">
            <i class="fa-regular fa-heart"></i>
            <h4>Hozircha saqlangan mashinalar yo'q</h4>
            <p>Katalogdagi istalgan avtomobil yurakcha belgisini bosing va shu yerda solishtiring.</p>
          </div>
        `;
        if (wishlistTotalPrice) wishlistTotalPrice.innerText = formatCurrency(0);
        return;
      }

      let total = 0;
      wishlistItemsList.innerHTML = '';
      wishlist.forEach((item, index) => {
        total += item.price;
        const row = document.createElement('div');
        row.className = 'wishlist-item';
        row.innerHTML = `
          <img src="${item.img}" alt="${item.name}" class="wi-img">
          <div class="wi-info">
            <h4 class="wi-name">${item.name}</h4>
            <span class="wi-price">${formatCurrency(item.price)}</span>
          </div>
          <button type="button" class="wi-remove" title="O'chirish" data-index="${index}">&times;</button>
        `;
        wishlistItemsList.appendChild(row);
      });

      if (wishlistTotalPrice) wishlistTotalPrice.innerText = formatCurrency(total);

      // O'chirish tugmalari
      wishlistItemsList.querySelectorAll('.wi-remove').forEach(btn => {
        btn.addEventListener('click', function(e) {
          e.stopPropagation();
          const idx = parseInt(this.getAttribute('data-index'));
          const removedName = wishlist[idx]?.name || '';
          wishlist.splice(idx, 1);
          saveWishlist();
          showToast(removedName ? `${removedName} saqlanganlardan o'chirildi!` : "O'chirildi!");
        });
      });
    }

    // Kartochkadagi yurakchalarga bosish hodisasi
    document.querySelectorAll('.car-card .car-like-icon').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        const card = this.closest('.car-card');
        if (!card) return;
        const name = card.getAttribute('data-name') || card.querySelector('.car-name')?.innerText.trim() || '';
        const price = parseInt(card.getAttribute('data-price')) || 0;
        const img = card.querySelector('img')?.getAttribute('src') || '';

        const existingIndex = wishlist.findIndex(item => item.name === name);
        if (existingIndex !== -1) {
          wishlist.splice(existingIndex, 1);
          saveWishlist();
          showToast(`${name} saqlanganlardan olib tashlandi.`);
        } else {
          wishlist.push({ name, price, img });
          saveWishlist();
          showToast(`❤️ ${name} saqlanganlarga qo'shildi!`);
        }
      });
    });

    // Drawer ochish / yopish
    function openWishlistDrawer() {
      if (wishlistDrawer) wishlistDrawer.classList.add('active');
      if (wishlistBackdrop) wishlistBackdrop.classList.add('active');
      document.body.style.overflow = 'hidden';
      updateWishlistUI();
    }

    function closeWishlistDrawer() {
      if (wishlistDrawer) wishlistDrawer.classList.remove('active');
      if (wishlistBackdrop) wishlistBackdrop.classList.remove('active');
      document.body.style.overflow = '';
    }

    if (wishlistToggleBtn) wishlistToggleBtn.addEventListener('click', openWishlistDrawer);
    if (wishlistCloseBtn) wishlistCloseBtn.addEventListener('click', closeWishlistDrawer);
    if (wishlistBackdrop) wishlistBackdrop.addEventListener('click', closeWishlistDrawer);

    if (wishlistClearBtn) {
      wishlistClearBtn.addEventListener('click', () => {
        if (wishlist.length === 0) return;
        if (confirm("Saqlangan barcha avtomobillarni tozalashni xohlaysizmi?")) {
          wishlist = [];
          saveWishlist();
          showToast("Saqlanganlar ro'yxati tozalandi.");
        }
      });
    }

    if (wishlistOrderAllBtn) {
      wishlistOrderAllBtn.addEventListener('click', () => {
        if (wishlist.length === 0) {
          alert("Saqlangan mashinalar mavjud emas.");
          return;
        }
        closeWishlistDrawer();
        const namesList = wishlist.map((item, i) => `${i + 1}. ${item.name} (${formatCurrency(item.price)})`).join('%0A');
        const tgText = `Assalomu alaykum! AutoMotors saytidan quyidagi saqlangan avtomobillar bo'yicha ma'lumot olmoqchiman:%0A%0A${namesList}%0A%0AMaslahat berishingizni so'rayman.`;
        window.open(`https://t.me/+998973419500?text=${tgText}`, '_blank');
      });
    }

    updateWishlistUI();

    // ----------------------------------------------------------
    // C. TRADE-IN KALKULYATORI MOTOR
    // ----------------------------------------------------------
    const tiBrand = document.getElementById('tiBrand');
    const tiModel = document.getElementById('tiModel');
    const tiYear = document.getElementById('tiYear');
    const tiCondition = document.getElementById('tiCondition');
    const tiMileageRange = document.getElementById('tiMileageRange');
    const tiMileageDisplay = document.getElementById('tiMileageDisplay');
    const tiNewCarSelect = document.getElementById('tiNewCarSelect');
    const tiOldPriceDisplay = document.getElementById('tiOldPriceDisplay');
    const tiNewPriceDisplay = document.getElementById('tiNewPriceDisplay');
    const tiDiffDisplay = document.getElementById('tiDiffDisplay');
    const tiMonthlyCreditDisplay = document.getElementById('tiMonthlyCreditDisplay');
    const tiSubmitBtn = document.getElementById('tiSubmitBtn');

    if (tiNewCarSelect) {
      allCarsData.forEach((car, i) => {
        const opt = document.createElement('option');
        opt.value = i;
        opt.text = car.name + ' ($' + car.price.toLocaleString('en-US') + ')';
        tiNewCarSelect.appendChild(opt);
      });
      tiNewCarSelect.value = 1; // Default Tracker 2
    }

    function calculateTradeIn() {
      if (!tiModel || !tiYear || !tiCondition || !tiMileageRange || !tiNewCarSelect) return;

      const basePrice = parseInt(tiModel.selectedOptions[0]?.getAttribute('data-base')) || 10000;
      const year = parseInt(tiYear.value) || 2022;
      const mileage = parseInt(tiMileageRange.value) || 45000;
      const conditionMult = parseFloat(tiCondition.value) || 1.0;

      // Amortizatsiya formulasi
      const yearDiff = Math.max(0, 2024 - year);
      const yearFactor = Math.max(0.4, 1 - (yearDiff * 0.045));
      const mileageFactor = Math.max(0.6, 1 - ((mileage / 100000) * 0.07));

      const oldCarPrice = Math.max(2000, Math.round(basePrice * yearFactor * mileageFactor * conditionMult));
      const newCarIndex = parseInt(tiNewCarSelect.value) || 0;
      const newCar = allCarsData[newCarIndex] || allCarsData[0];
      const newCarPrice = newCar.price;

      const diff = Math.max(0, newCarPrice - oldCarPrice);

      // 36 oylik kredit hisobi farq summasiga
      const annualRate = 0.18;
      const monthlyRate = annualRate / 12;
      const months = 36;
      let monthlyCredit = 0;
      if (diff > 0) {
        monthlyCredit = Math.round(
          (diff * monthlyRate * Math.pow(1 + monthlyRate, months)) /
          (Math.pow(1 + monthlyRate, months) - 1)
        );
      }

      if (tiMileageDisplay) tiMileageDisplay.innerText = mileage.toLocaleString('ru-RU') + ' km';
      if (tiOldPriceDisplay) tiOldPriceDisplay.innerText = formatCurrency(oldCarPrice);
      if (tiNewPriceDisplay) tiNewPriceDisplay.innerText = formatCurrency(newCarPrice);
      if (tiDiffDisplay) tiDiffDisplay.innerText = formatCurrency(diff);
      if (tiMonthlyCreditDisplay) tiMonthlyCreditDisplay.innerText = formatCurrency(monthlyCredit, true);
    }

    if (tiBrand) tiBrand.addEventListener('change', calculateTradeIn);
    if (tiModel) tiModel.addEventListener('change', calculateTradeIn);
    if (tiYear) tiYear.addEventListener('change', calculateTradeIn);
    if (tiCondition) tiCondition.addEventListener('change', calculateTradeIn);
    if (tiMileageRange) tiMileageRange.addEventListener('input', calculateTradeIn);
    if (tiNewCarSelect) tiNewCarSelect.addEventListener('change', calculateTradeIn);

    if (tiSubmitBtn) {
      tiSubmitBtn.addEventListener('click', function() {
        const oldModelName = tiModel?.selectedOptions[0]?.text || '';
        const oldYearVal = tiYear?.value || '2022';
        const oldKm = tiMileageRange?.value || '45000';
        const newCar = allCarsData[parseInt(tiNewCarSelect?.value) || 0];

        const notes = document.getElementById('client-notes');
        if (notes && newCar) {
          notes.value = `[Trade-In Buyurtmasi]: Eski mashina: ${oldModelName} (${oldYearVal} yil, ${oldKm} km). Yangi olinadigan: ${newCar.name}.`;
        }

        const select = document.getElementById('car-select');
        if (select && newCar) {
          for (let i = 0; i < select.options.length; i++) {
            if (select.options[i].text.toLowerCase().includes(newCar.name.toLowerCase().split(' ')[1])) {
              select.selectedIndex = i;
              break;
            }
          }
        }

        const contactSec = document.getElementById('contact');
        if (contactSec) contactSec.scrollIntoView({ behavior: 'smooth' });
        showToast("Trade-In ma'lumotlari arizaga to'ldirildi!");
      });
    }

    calculateTradeIn();

    // ----------------------------------------------------------
    // D. MAXSUS AKSIYA TAYMERI (COUNTDOWN TIMER)
    // ----------------------------------------------------------
    // Hozirgi oydan boshlab 4 kun 14 soatlik davriy aksiya
    const cdDays = document.getElementById('cdDays');
    const cdHours = document.getElementById('cdHours');
    const cdMins = document.getElementById('cdMins');
    const cdSecs = document.getElementById('cdSecs');

    let promoTarget = localStorage.getItem('automotors_promo_end');
    if (!promoTarget || new Date(promoTarget) <= new Date()) {
      const targetDate = new Date();
      targetDate.setDate(targetDate.getDate() + 4);
      targetDate.setHours(targetDate.getHours() + 14);
      promoTarget = targetDate.toISOString();
      localStorage.setItem('automotors_promo_end', promoTarget);
    }

    function updateCountdown() {
      const now = new Date().getTime();
      const target = new Date(promoTarget).getTime();
      const diff = target - now;

      if (diff <= 0) {
        if (cdDays) cdDays.innerText = '00';
        if (cdHours) cdHours.innerText = '00';
        if (cdMins) cdMins.innerText = '00';
        if (cdSecs) cdSecs.innerText = '00';
        return;
      }

      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const secs = Math.floor((diff % (1000 * 60)) / 1000);

      if (cdDays) cdDays.innerText = String(days).padStart(2, '0');
      if (cdHours) cdHours.innerText = String(hours).padStart(2, '0');
      if (cdMins) cdMins.innerText = String(mins).padStart(2, '0');
      if (cdSecs) cdSecs.innerText = String(secs).padStart(2, '0');
    }
    updateCountdown();
    setInterval(updateCountdown, 1000);

    // ----------------------------------------------------------
    // E. RANG TANLAGICH (COLOR VISUALIZER IN MODAL)
    // ----------------------------------------------------------
    let selectedModalColor = 'Oq (Summit White)';
    document.querySelectorAll('#cmColorSwatches .color-swatch').forEach(swatch => {
      swatch.addEventListener('click', function() {
        document.querySelectorAll('#cmColorSwatches .color-swatch').forEach(s => s.classList.remove('active'));
        this.classList.add('active');
        selectedModalColor = this.getAttribute('data-color') || 'Oq (Summit White)';
        const lbl = document.getElementById('cmSelectedColorName');
        if (lbl) lbl.innerText = selectedModalColor;
      });
    });

    // ----------------------------------------------------------
    // F. PDF / RASMIY NARXLAR JADVALINI YUKLAB OLISH & CHOP ETISH
    // ----------------------------------------------------------
    const btnPdfCatalog = document.getElementById('btnPdfCatalog');
    if (btnPdfCatalog) {
      btnPdfCatalog.addEventListener('click', function() {
        // Avtosalon kotirovka oynasini ochish va chop etish
        window.print();
      });
    }

    // Inits
    updateCalculator();
    updateComparison();
    calculateTradeIn();

  </script>


  <!-- ==========================================================
       FLOATING ACTIONS (Tezkor aloqa va yuqoriga tugmalari)
       ========================================================== -->
  <div class="floating-actions">
    <!-- Yuqoriga qaytish -->
    <a href="#home" class="float-btn float-top" title="Yuqoriga chiqish" aria-label="Yuqoriga">
      <i class="fa-solid fa-chevron-up"></i>
    </a>
    <!-- Telegram -->
    <a href="https://t.me/+998973419500" target="_blank" class="float-btn float-tg" title="Telegramda yozish" aria-label="Telegram">
      <i class="fa-brands fa-telegram"></i>
    </a>
    <!-- Telefon qo'ng'irog'i -->
    <a href="tel:+998973419500" class="float-btn float-phone" title="Qo'ng'iroq qilish" aria-label="Qo'ng'iroq">
      <i class="fa-solid fa-phone"></i>
    </a>
  </div>

</body>

</html>